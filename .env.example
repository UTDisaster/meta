APP_ENV=dev

# Required for Gemini-backed endpoints
GEMINI_API_KEY=your_gemini_api_key_here

# Container-local DB connection (meta compose uses service name "postgis")
DATABASE_URL=postgresql+psycopg://utd:utdpass@postgis:5432/utd_data

# Filename-only image paths resolve under this URL
IMAGE_CONTENT_BASE_URL=http://localhost:8000/assets/images/hurricane-florence

# Keep both rooted at data-example for preprocess + VLM scripts
PARSED_DATA_DIR=/app/data-example
VLM_DATASET_DIR=/app/data-example

CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
