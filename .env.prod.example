APP_ENV=prod

GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgresql+psycopg://utd:utdpass@postgis:5432/utd_data

# Example production image CDN/base URL (filename appended by backend)
IMAGE_CONTENT_BASE_URL=https://res.cloudinary.com/your-cloud/image/upload/q_auto/f_auto

# Kept for canonical parity; not used for CDN-hosted production images
PARSED_DATA_DIR=/app/data-example
VLM_DATASET_DIR=/app/data-example

CORS_ALLOW_ORIGIN_REGEX=^https://.*\.vercel\.app$
CORS_ALLOW_ORIGINS=
